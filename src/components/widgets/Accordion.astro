---
/**
 * AccordionDemo — 3 expandable sections using native <details>/<summary>.
 *
 * No client directive needed — native browser expand/collapse.
 *
 * Token consumption:
 *   astro-accordion            → container (bg-surface, border, radius, overflow)
 *   astro-accordion__summary   → summary row (flex, padding, cursor)
 *   astro-accordion__body      → content area (padding, border-top, typography)
 *
 * Height transition (progressive enhancement):
 *   Uses interpolate-size + ::details-content pseudo-element (Chrome 131+).
 *   Open timing: --astro-easing-tab-open
 *   Close timing: --astro-easing-tab-close
 *   Older browsers get instant open/close.
 */

const ITEMS = [
  {
    id: 'a1',
    summary: 'What is a design token?',
    body: 'A design token is a named CSS custom property (e.g. --spacing-md: 1rem) that centralises a raw value behind a semantic name, making it easy to update globally.',
  },
  {
    id: 'a2',
    summary: 'How does the panel update tokens live?',
    body: 'The panel writes :root overrides directly into the page via a <style> tag, so every class that references a --astro-* var picks up the new value before the next paint — no rebuild required.',
  },
  {
    id: 'a3',
    summary: 'Which easing tokens does this accordion use?',
    body: 'The open transition uses easing-tab-open and the close transition uses easing-tab-close. Change either in the Easing tab of the panel to see the effect here.',
  },
] as const;
---

<!--
  Scoped transition rules for accordion open/close.
  reason: ::details-content pseudo-element requires a stylesheet rule;
  inline style cannot target pseudo-elements
-->
<style>
  .astro-accordion-demo-item {
    interpolate-size: allow-keywords;
  }
  .astro-accordion-demo-item::details-content {
    transition: height 0.3s var(--astro-easing-tab-open),
                opacity 0.3s var(--astro-easing-tab-open);
    overflow: hidden;
  }
  .astro-accordion-demo-item:not([open])::details-content {
    transition: height 0.3s var(--astro-easing-tab-close),
                opacity 0.3s var(--astro-easing-tab-close);
  }
</style>

<div style={`display:flex;flex-direction:column;gap:var(--astro-vsp-sm)`}>
  {ITEMS.map((item) => (
    <details class="astro-accordion astro-accordion-demo-item">
      <summary class="astro-accordion__summary">
        <span>{item.summary}</span>
        <span class="astro-helper" style="user-select:none">&#9662;</span>
      </summary>
      <div class="astro-accordion__body">
        <span>{item.body}</span>
        <div class="astro-helper" style={`margin-top:var(--astro-vsp-sm)`}>
          Open timing: <code>easing-tab-open</code> &#x2192;{' '}
          <code>--astro-easing-tab-open</code>. Close timing:{' '}
          <code>easing-tab-close</code> &#x2192;{' '}
          <code>--astro-easing-tab-close</code>.
        </div>
      </div>
    </details>
  ))}
</div>
