---
/**
 * AvatarRow — 4 small avatars using size-avatar-sm, each with a palette background.
 *
 * Token consumption:
 *   astro-avatar.is-sm → each avatar (width/height from --astro-size-avatar-sm)
 *
 * Palette backgrounds applied via inline style: var(--astro-palette-{i})
 * reason: dynamic var name from loop index — no static class can express this
 */

const AVATAR_PALETTE_INDICES = [1, 2, 3, 4] as const;
---

<div role="list" aria-label="Avatar row" style="display:flex;gap:var(--astro-hsp-sm)">
  {AVATAR_PALETTE_INDICES.map((i) => (
    <div
      role="listitem"
      class="astro-avatar is-sm"
      style={`background: var(--astro-palette-${i})`}
      aria-hidden="true"
    />
  ))}
</div>
