---
/**
 * StatCard — metric display with a prominent large number.
 *
 * Token consumption:
 *   astro-card       → surface container
 *   astro-stat-value → big metric number (page-title font-size, primary color)
 *   astro-helper     → label (muted, helper font-size)
 */

interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<div class="astro-card" style="display:flex;flex-direction:column;gap:var(--astro-vsp-xs)">
  <span class="astro-stat-value">{value}</span>
  <span class="astro-helper">{label}</span>
</div>
