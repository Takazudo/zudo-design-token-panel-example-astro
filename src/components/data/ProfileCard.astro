---
/**
 * ProfileCard — avatar + name + role + action button.
 *
 * Token consumption:
 *   astro-card           → surface container
 *   astro-avatar.is-md   → avatar circle (bg from --astro-color-accent)
 *   astro-subsection-title → name
 *   astro-helper         → role label (muted)
 *   astro-button         → follow button (accent fill)
 */

interface Props {
  name: string;
  role: string;
}

const { name, role } = Astro.props;
---

<div class="astro-card" style="display:flex;align-items:center;gap:var(--astro-hsp-md)">
  <div
    class="astro-avatar is-md"
    style="background:var(--astro-color-accent);flex-shrink:0"
    aria-hidden="true"
  />
  <div style="display:flex;flex-direction:column;gap:var(--astro-vsp-2xs);flex:1">
    <span class="astro-subsection-title">{name}</span>
    <span class="astro-helper">{role}</span>
  </div>
  <div role="button" tabindex="0" class="astro-button" style="flex-shrink:0">Follow</div>
</div>
