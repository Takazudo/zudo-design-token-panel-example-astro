---
/**
 * Shared layout for the Astro example. Mounts <DesignTokenPanelHost> at the
 * end of <body> so the panel attaches once per page navigation. The
 * <ClientRouter /> import wires Astro's view-transition lifecycle — the
 * panel's host adapter listens for `astro:before-swap` / `astro:page-load`
 * and re-materialises the shell automatically.
 *
 * Side-effect CSS imports
 * -----------------------
 *  - `reset.css` is the demo's minimal preflight.
 *  - `tokens.css` declares every `--astro-*` variable on `:root` AND
 *    is the file the apply pipeline rewrites on disk (single source of
 *    truth for the round-trip).
 *
 * No panel stylesheet import: the panel entry self-injects its chrome CSS on
 * first mount (PORTABLE-CONTRACT §7.5), so visitors who never load the panel
 * pay no panel CSS cost.
 */

import { ClientRouter } from 'astro:transitions';
// Import the host component from its dedicated `.astro` export so Astro
// compiles it natively. The `@takazudo/zdtp/astro` JS index statically pulls
// this same `.astro`, which Node cannot load from node_modules at prerender
// time (ERR_UNKNOWN_FILE_EXTENSION). Type-only imports from the JS index stay
// fine since they are erased at build.
import DesignTokenPanelHost from '@takazudo/zdtp/astro/DesignTokenPanelHost.astro';
import { panelConfig } from '../config/panel-config';

import '../styles/reset.css';
import '../styles/tokens.css';
import '../styles/components.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <slot />
    <DesignTokenPanelHost config={panelConfig} />
  </body>
</html>

<script>
  // Required side-effect load for the package's host adapter. We use a
  // dynamic `import()` (not a top-level `import '...';`) because Vite/Rollup
  // strips top-level side-effect imports of external packages from hoisted
  // Astro <script> blocks. The dynamic import lands as a real `import()`
  // call in the bundled output so the host-adapter chunk reliably reaches
  // prod and `window.<consoleNamespace>.*` exists at runtime.
  const adapterReady = import('@takazudo/zdtp/astro/host-adapter');

  // The topbar trigger waits for the adapter: the console API it calls only
  // exists once the adapter module has run, so a click that lands before the
  // dynamic import resolves would otherwise be dropped. Delegated from
  // `document` because this module script runs once per full page load and
  // must keep working across ClientRouter swaps.
  type ConsoleApi = { toggleDesignPanel?: () => Promise<void> };
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element) || !target.closest('[data-design-panel-toggle]')) return;
    void adapterReady.then(() =>
      (window as unknown as { astro?: ConsoleApi }).astro?.toggleDesignPanel?.(),
    );
  });
</script>
